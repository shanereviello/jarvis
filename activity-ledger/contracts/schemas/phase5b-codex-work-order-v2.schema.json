{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/contracts/schemas/phase5b-codex-work-order-v2.schema.json",
  "title": "Phase 5B Codex Executor Work Order v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "request_id", "claim_id", "run_id", "task_key", "contract_sha256", "controller_id", "attempt_number", "workflow_template", "executor_profile", "model_profile", "repository_registration_id", "allocation_id", "worktree_id", "baseline_commit", "task_branch", "instruction_manifest", "validation_plan_id", "validation_plan_sha256", "validation_commands", "resource_limits", "executor_deadline_unix_seconds", "output_policy", "recipe", "normalized_contract"],
  "properties": {
    "schema_name": {"const": "phase5b-codex-work-order"}, "schema_version": {"const": "2"},
    "request_id": {"$ref": "#/$defs/uuid"}, "claim_id": {"$ref": "#/$defs/uuid"}, "run_id": {"$ref": "#/$defs/uuid"},
    "task_key": {"type": "string", "pattern": "^TASK-[0-9]{8}-[0-9]{3}$"}, "contract_sha256": {"$ref": "#/$defs/sha256"}, "controller_id": {"$ref": "#/$defs/identifier"}, "attempt_number": {"const": 1},
    "workflow_template": {"const": "phase5b-bounded-codex-code-change-v2"}, "executor_profile": {"const": "phase5b-codex-executor-v2"}, "model_profile": {"const": "phase5b_model_profile_v1"},
    "repository_registration_id": {"$ref": "#/$defs/identifier"}, "allocation_id": {"$ref": "#/$defs/uuid"}, "worktree_id": {"$ref": "#/$defs/uuid"}, "baseline_commit": {"$ref": "#/$defs/git_commit"},
    "task_branch": {"type": "string", "pattern": "^(?!main$)(?!.*[\\\\\\x00])[^/][^\\x00]{0,127}$"},
    "instruction_manifest": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/instruction"}}, "validation_plan_id": {"const": "phase5b-disposable-python-unit-v1"}, "validation_plan_sha256": {"$ref": "#/$defs/sha256"},
    "validation_commands": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object"}}, "resource_limits": {"type": "object"}, "executor_deadline_unix_seconds": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "output_policy": {"const": "local-commit-no-remote-v1"}, "recipe": {"const": "phase5b-codex-code-change-v2"},
    "normalized_contract": {"$ref": "#/$defs/normalized_contract"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "instruction": {"type": "object", "additionalProperties": false, "required": ["relative_path", "sha256", "size_bytes", "media_type"], "properties": {"relative_path": {"const": "AGENTS.md"}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 16384}, "media_type": {"const": "text/markdown"}}},
    "criterion": {"type": "object", "additionalProperties": false, "required": ["criterion_id", "statement", "required"], "properties": {"criterion_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "statement": {"type": "string", "minLength": 1, "maxLength": 2048}, "required": {"type": "boolean"}}},
    "context": {"type": "object", "additionalProperties": false, "required": ["context_id", "relative_path", "sha256", "size_bytes", "media_type", "purpose"], "properties": {"context_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "relative_path": {"type": "string", "minLength": 1, "maxLength": 255}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 0, "maximum": 65536}, "media_type": {"type": "string", "minLength": 1, "maxLength": 128}, "purpose": {"type": "string", "minLength": 1, "maxLength": 512}}},
    "normalized_contract": {"type": "object", "additionalProperties": false, "required": ["contract_version", "idempotency_key", "task_key", "operation", "workflow_template", "executor_profile", "requested_by", "objective", "acceptance_criteria", "permitted_context_manifest", "workspace", "input_artifacts", "context_references", "output_contract", "validation_profile", "limits", "requested_capabilities", "created_at", "phase5b_policy"], "properties": {"contract_version": {"const": "execution-request-v2"}, "idempotency_key": {"type": "string"}, "task_key": {"type": "string"}, "operation": {"const": "modify"}, "workflow_template": {"const": "phase5b-bounded-codex-code-change-v2"}, "executor_profile": {"const": "phase5b-codex-executor-v2"}, "requested_by": {"type": "string"}, "objective": {"type": "string", "minLength": 1, "maxLength": 8192}, "acceptance_criteria": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/criterion"}}, "permitted_context_manifest": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/context"}}, "workspace": {"type": "object"}, "input_artifacts": {"const": []}, "context_references": {"const": []}, "output_contract": {"type": "object"}, "validation_profile": {"const": "phase5b-disposable-python-unit-v1"}, "limits": {"type": "object"}, "requested_capabilities": {"const": ["git_read", "git_write_workspace", "test_structured_argv"]}, "created_at": {"type": "string"}, "phase5b_policy": {"type": "object"}}}
  }
}
