{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/contracts/schemas/phase5a-model-free-executor-failure.schema.json",
  "title": "Phase 5A Model-Free Executor Failure Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "request_id",
    "claim_id",
    "run_id",
    "contract_sha256",
    "executor_profile",
    "outcome",
    "failure_code"
  ],
  "properties": {
    "schema_name": {"const": "phase5a-model-free-executor-failure"},
    "schema_version": {"const": "1"},
    "request_id": {"$ref": "#/$defs/uuid"},
    "claim_id": {"$ref": "#/$defs/uuid"},
    "run_id": {"$ref": "#/$defs/uuid"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "executor_profile": {"const": "phase5a-model-free-executor-v1"},
    "outcome": {"const": "failed"},
    "failure_code": {
      "enum": [
        "work_order_rejected",
        "deadline_exceeded",
        "evidence_generation_failed",
        "evidence_publication_failed"
      ]
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    }
  }
}
