{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/contracts/schemas/phase5b-codex-work-order-v1.schema.json",
  "title": "Phase 5B Codex Executor Work Order v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "request_id", "claim_id", "run_id", "task_key", "contract_sha256", "controller_id", "attempt_number", "workflow_template", "executor_profile", "model_profile", "repository_registration_id", "allocation_id", "worktree_id", "baseline_commit", "task_branch", "instruction_manifest", "validation_plan_id", "validation_plan_sha256", "validation_commands", "resource_limits", "executor_deadline_unix_seconds", "output_policy", "recipe"],
  "properties": {
    "schema_name": {"const": "phase5b-codex-work-order"},
    "schema_version": {"const": "1"},
    "request_id": {"$ref": "#/$defs/uuid"}, "claim_id": {"$ref": "#/$defs/uuid"}, "run_id": {"$ref": "#/$defs/uuid"},
    "task_key": {"type": "string", "pattern": "^TASK-[0-9]{8}-[0-9]{3}$"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "controller_id": {"$ref": "#/$defs/identifier"},
    "attempt_number": {"const": 1},
    "workflow_template": {"const": "phase5b-bounded-codex-code-change-v1"},
    "executor_profile": {"const": "phase5b-codex-executor-v1"},
    "model_profile": {"const": "phase5b_model_profile_v1"},
    "repository_registration_id": {"$ref": "#/$defs/identifier"},
    "allocation_id": {"$ref": "#/$defs/uuid"}, "worktree_id": {"$ref": "#/$defs/uuid"},
    "baseline_commit": {"$ref": "#/$defs/git_commit"},
    "task_branch": {"type": "string", "pattern": "^(?!main$)(?!.*[\\\\\\x00])[^/][^\\x00]{0,127}$"},
    "instruction_manifest": {"type": "array", "minItems": 0, "maxItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/instruction"}},
    "validation_plan_id": {"const": "phase5b-disposable-python-unit-v1"},
    "validation_plan_sha256": {"$ref": "#/$defs/sha256"},
    "validation_commands": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/validation_command"}},
    "resource_limits": {"$ref": "#/$defs/resource_limits"},
    "executor_deadline_unix_seconds": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "output_policy": {"const": "local-commit-no-remote-v1"},
    "recipe": {"const": "phase5b-codex-code-change-v1"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "minLength": 36, "maxLength": 36},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$", "minLength": 40, "maxLength": 40},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", "minLength": 1, "maxLength": 128},
    "instruction": {
      "type": "object", "additionalProperties": false, "required": ["relative_path", "sha256", "size_bytes", "media_type"],
      "properties": {"relative_path": {"const": "AGENTS.md"}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 16384}, "media_type": {"const": "text/markdown"}}
    },
    "validation_command": {
      "type": "object", "additionalProperties": false, "required": ["command_id", "argv", "cwd_relative", "timeout_seconds", "warnings_as_errors"],
      "properties": {
        "command_id": {"const": "unit"},
        "argv": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^;&|$`()<>\\x00\\\\]+$"}, "uniqueItems": false},
        "cwd_relative": {"const": "."}, "timeout_seconds": {"const": 45}, "warnings_as_errors": {"type": "boolean"}
      }
    },
    "resource_limits": {
      "type": "object", "additionalProperties": false,
      "required": ["overall_timeout_seconds", "model_deadline_seconds", "validation_deadline_seconds", "max_model_iterations", "max_tool_calls", "max_changed_files", "max_total_changed_bytes", "max_changed_file_bytes", "max_patch_bytes", "max_validation_commands", "max_stdout_bytes", "max_stderr_bytes", "max_instruction_files", "max_instruction_bytes", "max_model_summary_bytes", "max_result_bytes", "max_failure_bytes", "max_commit_message_bytes"],
      "properties": {
        "overall_timeout_seconds": {"const": 180}, "model_deadline_seconds": {"const": 120}, "validation_deadline_seconds": {"const": 45}, "max_model_iterations": {"const": 8}, "max_tool_calls": {"const": 32}, "max_changed_files": {"const": 8}, "max_total_changed_bytes": {"const": 32768}, "max_changed_file_bytes": {"const": 8192}, "max_patch_bytes": {"const": 65536}, "max_validation_commands": {"const": 1}, "max_stdout_bytes": {"const": 16384}, "max_stderr_bytes": {"const": 16384}, "max_instruction_files": {"const": 1}, "max_instruction_bytes": {"const": 16384}, "max_model_summary_bytes": {"const": 16384}, "max_result_bytes": {"const": 131072}, "max_failure_bytes": {"const": 32768}, "max_commit_message_bytes": {"const": 200}
      }
    }
  }
}
