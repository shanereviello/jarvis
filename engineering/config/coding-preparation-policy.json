        "docs/hosts/README.md",
        "docs/hosts/raspberry-pi.md",
        "docs/procedures/README.md",
        "docs/decisions/README.md",
        "docs/observations/README.md",
        "docs/assets/README.md",
        "docs/templates/ros-package.md",
        "docs/templates/ros-node.md",
        "docs/templates/hardware-component.md",
