{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rras:engineering-scope:v1",
  "title": "Versioned private engineering scope metadata",
  "type": "object",
  "properties": {
    "client_event_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expected_head": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "repository"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "non_git"
            },
            "id": {
              "const": "jarvis-non-git"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "agent_reported",
            "human_reported",
            "imported"
          ]
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}(?![\\s\\S])"
        },
        "id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "namespace",
        "id"
      ],
      "additionalProperties": false
    },
    "occurred_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "contract": {
      "const": "engineering-scope.v1"
    },
    "operation": {
      "enum": [
        "scope.create",
        "scope.revise"
      ]
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "repository_url": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "change_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "revision",
        "display_name",
        "description",
        "repository_url",
        "change_summary"
      ]
    }
  },
  "required": [
    "client_event_key",
    "expected_head",
    "scope",
    "source",
    "occurred_at",
    "contract",
    "operation",
    "body"
  ],
  "additionalProperties": false
}
