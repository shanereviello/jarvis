{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rras:engineering-history:v1",
  "title": "Engineering history local intake v1",
  "description": "Passive private engineering records; no execution or authenticated human authority.",
  "type": "object",
  "properties": {
    "contract": {
      "const": "engineering-history.v1"
    },
    "operation": {
      "enum": [
        "work.create",
        "work.revise",
        "session.attach",
        "checkpoint.append",
        "outcome.record",
        "document.render"
      ]
    },
    "client_event_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expected_head": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "agent_reported",
            "human_reported",
            "imported"
          ]
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}(?![\\s\\S])"
        },
        "id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "namespace",
        "id"
      ],
      "additionalProperties": false
    },
    "occurred_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "object"
    }
  },
  "required": [
    "contract",
    "operation",
    "client_event_key",
    "expected_head",
    "source",
    "occurred_at",
    "body"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "work.create"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "work_item_id": {
                "type": "string",
                "pattern": "^wrk_[0-9a-f]{32}(?![\\s\\S])"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "repository_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}(?![\\s\\S])"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "objective": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "acceptance_criteria": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}(?![\\s\\S])"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  },
                  "required": [
                    "id",
                    "description"
                  ],
                  "additionalProperties": false
                }
              },
              "allowed_paths": {
                "type": "array",
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "baseline": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "ref": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      },
                      "commit": {
                        "type": "string",
                        "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
                      }
                    },
                    "required": [
                      "ref",
                      "commit"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "work_item_id",
              "revision",
              "repository_id",
              "title",
              "objective",
              "rationale",
              "acceptance_criteria",
              "allowed_paths",
              "baseline"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "work.revise"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "work_item_id": {
                "type": "string",
                "pattern": "^wrk_[0-9a-f]{32}(?![\\s\\S])"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "repository_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}(?![\\s\\S])"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "objective": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "acceptance_criteria": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}(?![\\s\\S])"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  },
                  "required": [
                    "id",
                    "description"
                  ],
                  "additionalProperties": false
                }
              },
              "allowed_paths": {
                "type": "array",
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "baseline": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "ref": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      },
                      "commit": {
                        "type": "string",
                        "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
                      }
                    },
                    "required": [
                      "ref",
                      "commit"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "work_item_id",
              "revision",
              "repository_id",
              "title",
              "objective",
              "rationale",
              "acceptance_criteria",
              "allowed_paths",
              "baseline"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "session.attach"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "work_item_id": {
                "type": "string",
                "pattern": "^wrk_[0-9a-f]{32}(?![\\s\\S])"
              },
              "work_revision_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              },
              "client_namespace": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}(?![\\s\\S])"
              },
              "session_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "work_item_id",
              "work_revision_sha256",
              "client_namespace",
              "session_id"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
