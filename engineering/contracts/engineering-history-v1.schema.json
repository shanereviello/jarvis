                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              },
              "checkpoint_type": {
                "enum": [
                  "progress",
                  "pause",
                  "handoff",
                  "interruption"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "decisions": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "next_action": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "references": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "properties": {
                    "namespace": {
                      "enum": [
                        "session",
                        "git_commit",
                        "pull_request",
                        "external",
                        "operational_event",
                        "document"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "sha256": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "namespace",
                    "id",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "work_item_id",
              "work_revision_sha256",
              "checkpoint_type",
              "summary",
              "decisions",
              "next_action",
              "references"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "outcome.record"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "work_item_id": {
                "type": "string",
                "pattern": "^wrk_[0-9a-f]{32}(?![\\s\\S])"
              },
              "work_revision_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              },
              "outcome": {
                "enum": [
                  "completed_claim",
                  "partial",
                  "failed",
                  "unfinished",
                  "uncertain"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "references": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "properties": {
                    "namespace": {
                      "enum": [
                        "session",
                        "git_commit",
                        "pull_request",
                        "external",
                        "operational_event",
                        "document"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "sha256": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "namespace",
                    "id",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "work_item_id",
              "work_revision_sha256",
              "outcome",
              "summary",
              "references"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "document.render"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
