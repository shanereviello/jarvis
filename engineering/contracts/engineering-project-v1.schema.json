{
  "type": "object",
  "properties": {
    "contract": {
      "const": "engineering-project.v1"
    },
    "operation": {
      "enum": [
        "project.create",
        "project.revise",
        "project.state",
        "project.archive",
        "architecture.save",
        "architecture.designate",
        "baseline.record",
        "baseline.select",
        "membership.assign",
        "membership.remove",
        "membership.designate"
      ]
    },
    "client_event_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expected_head": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "repository"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "non_git"
            },
            "id": {
              "const": "jarvis-non-git"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{32}(?![\\s\\S])"
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "agent_reported",
            "human_reported",
            "imported"
          ]
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}(?![\\s\\S])"
        },
        "id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "namespace",
        "id"
      ],
      "additionalProperties": false
    },
    "occurred_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "object"
    }
  },
  "required": [
    "contract",
    "operation",
    "client_event_key",
    "expected_head",
    "scope",
    "project_id",
    "source",
    "occurred_at",
    "body"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rras:engineering-project:v1",
  "title": "Private project workspace operations",
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "project.create"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "overview": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "intended_outcome": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "in_scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "out_of_scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "owner": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "change_summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "revision",
              "name",
              "overview",
              "intended_outcome",
              "in_scope",
              "out_of_scope",
              "owner",
              "change_summary"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "project.revise"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "overview": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "intended_outcome": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "in_scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "out_of_scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "owner": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "change_summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "revision",
              "name",
              "overview",
              "intended_outcome",
              "in_scope",
              "out_of_scope",
              "owner",
              "change_summary"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "project.state"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "state": {
                "enum": [
                  "planned",
                  "active",
                  "paused",
                  "completed",
                  "cancelled"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "baseline_omission_reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "dispositions": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "properties": {
                    "work_item_id": {
                      "type": "string",
                      "pattern": "^wrk_[0-9a-f]{32}(?![\\s\\S])"
                    },
                    "disposition": {
                      "enum": [
                        "pending",
                        "deferred",
                        "cancelled"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  },
                  "required": [
                    "work_item_id",
                    "disposition",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "state",
              "reason",
              "baseline_omission_reason",
              "dispositions"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "project.archive"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "archived": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "archived",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "architecture.save"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "document_id": {
                "type": "string",
                "pattern": "^doc_[0-9a-f]{32}(?![\\s\\S])"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "previous_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "change_summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "markdown": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90000
              },
              "source_reference": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "document_id",
              "version",
              "previous_sha256",
              "title",
              "change_summary",
              "markdown",
              "source_reference"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "architecture.designate"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "markdown_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "version",
              "markdown_sha256",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "baseline.record"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "baseline_id": {
                "type": "string",
                "pattern": "^bas_[0-9a-f]{32}(?![\\s\\S])"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "previous_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "commit": {
                "type": "string",
                "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
              },
              "ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "source_reference": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "verified_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "Z$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "baseline_id",
              "version",
              "previous_sha256",
              "commit",
              "ref",
              "label",
              "reason",
              "source_reference",
              "verified_at"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "baseline.select"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "role": {
                "enum": [
                  "starting",
                  "current"
                ]
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "baseline_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "role",
              "version",
              "baseline_sha256",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "membership.assign"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "work_item_id": {
                "type": "string",
                "pattern": "^wrk_[0-9a-f]{32}(?![\\s\\S])"
              },
              "expected_assignment_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "expected_previous_project_head": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "architecture_version": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "work_item_id",
              "expected_assignment_sha256",
              "expected_previous_project_head",
              "architecture_version",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "membership.remove"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "work_item_id": {
                "type": "string",
                "pattern": "^wrk_[0-9a-f]{32}(?![\\s\\S])"
              },
              "expected_assignment_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "work_item_id",
              "expected_assignment_sha256",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "membership.designate"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "work_item_id": {
                "type": "string",
                "pattern": "^wrk_[0-9a-f]{32}(?![\\s\\S])"
              },
              "expected_assignment_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              },
              "architecture_version": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "work_item_id",
              "expected_assignment_sha256",
              "architecture_version",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
