[Unit]
Description=Run bounded desktop Codex evidence collection
ConditionPathExists=/home/shanereviello/Documents/Codex/.rras-desktop-capture/config.json

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=10s
Persistent=true
Unit=rras-desktop-capture.service

[Install]
WantedBy=timers.target
